{
  "name": "callout-site",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing website for Callout, the trades marketplace with guild-governed prices.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
